NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Directus base URL, for example: https://cms.example.com
DIRECTUS_URL=http://localhost:8055
# Server-side API token with read access to website collections and create access to inquiries
DIRECTUS_TOKEN=
# Shared secret used by Directus webhook / flow to trigger frontend revalidation
REVALIDATE_SECRET=change-me
# Reserved for optional email fallback or notification handling
INQUIRY_RECEIVER_EMAIL=sales@example.com
